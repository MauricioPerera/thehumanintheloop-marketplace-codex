{
  "name": "echo-pace-logistics-erp-analysis",
  "version": "1.0.0",
  "source": "local:pasted-text.txt",
  "provenance": {
    "kind": "local-code-analysis",
    "observedAt": "2026-08-04",
    "officialSystem": false,
    "limitations": ["No computed CSS", "No live viewport inspection", "Mock business data in source"]
  },
  "colors": {
    "brand": {"sidebarStart": "#1D4ED8", "sidebarEnd": "#1E3A8A", "action": "#2563EB", "actionHover": "#1D4ED8", "soft": "#DBEAFE"},
    "surface": {"page": "#F9FAFB", "card": "#FFFFFF"},
    "border": {"subtle": "#F3F4F6", "default": "#D1D5DB"},
    "text": {"heading": "#1F2937", "body": "#4B5563", "muted": "#6B7280"},
    "status": {"success": "#22C55E", "warning": "#EAB308", "danger": "#EF4444", "info": "#3B82F6", "purple": "#A855F7"},
    "chart": ["#2563EB", "#3B82F6", "#60A5FA", "#93C5FD"]
  },
  "typography": {
    "family": "ui-sans-serif, system-ui, sans-serif",
    "sizes": {"xs": "12px", "sm": "14px", "base": "16px", "lg": "18px", "xl": "20px", "2xl": "24px", "3xl": "30px"},
    "weights": {"medium": 500, "semibold": 600, "bold": 700},
    "lineHeights": {"base": "24px", "compact": "20px"}
  },
  "spacing": {"base": "4px", "scale": ["4px", "8px", "12px", "16px", "24px", "32px"], "cardPadding": "24px", "moduleGap": "24px"},
  "radii": {"control": "8px", "card": "12px", "pill": "9999px"},
  "layout": {"sidebarWidth": "256px", "desktopColumns": 4, "tabletColumns": 2, "mobileColumns": 1, "chartColumnsDesktop": 2, "tableOverflow": "horizontal-localized"},
  "motion": {"cardHoverTranslateY": "-5px", "contentEntrance": "opacity 0 to 1", "loading": "spinner"},
  "components": {
    "sidebar": {"tokens": ["{colors.brand.sidebarStart}", "{colors.brand.sidebarEnd}"], "states": ["default", "active", "hover"]},
    "statCard": {"tokens": ["{colors.surface.card}", "{colors.border.subtle}", "{colors.status.success}", "{colors.status.danger}"], "states": ["default", "hover", "positive", "negative"]},
    "table": {"tokens": ["{colors.surface.card}", "{colors.surface.page}", "{colors.text.muted}"], "states": ["default", "row-hover", "status-select"]},
    "statusPill": {"tokens": ["{colors.status.success}", "{colors.status.warning}", "{colors.status.danger}", "{colors.status.info}"], "states": ["delivered", "pending", "delayed", "in-transit", "paid", "overdue"]},
    "form": {"tokens": ["{colors.border.default}", "{colors.brand.action}"], "states": ["default", "focus", "required", "loading"]},
    "chartCard": {"tokens": ["{colors.surface.card}", "{colors.chart}"], "states": ["default", "tooltip", "legend"]}
  }
}
